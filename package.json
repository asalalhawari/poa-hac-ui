{
  "name": "poa-hac-ui",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/server.ts",
    "server:start": "tsx server/server.ts",
    "server:test": "tsx --test server/__tests__/hacScoring.test.ts",
    "dev:all": "concurrently -n API,UI -c auto \"npm run server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "tsx server/server.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "latest",
    "playwright": "^1.63.0",
    "typescript": "latest",
    "vercel": "^60.1.3",
    "vite": "latest"
  }
}
